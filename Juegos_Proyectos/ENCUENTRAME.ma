  "npcs": {
   "pmuvaxq7m": {
    "id": "pmuvaxq7m",
    "name": "Ruby",
    "desc": "Una joven de pelo carmesí, ojos color miel, una sonrisa burla, pero agradable. Con la paciencia de un caracol. ",
    "dlg": "Por fin has llegado. Te tomaste tu tiempo.\n¿Puedo Besarte? Anda di que sí.",
    "hos": "aliado",
    "hp": 8,
    "atk": 2,
    "def": 0,
    "vel": 2,
    "gold": 3,
    "weak": "",
    "alias": "",
    "inv": "",
    "muestra": false,
    "acepta": "",
    "ack": "",
    "rech": "",
    "gflag": "",
    "da": "",
    "ruta": "",
    "cada": 0,
    "modo": "ciclo",
    "eib": ""
   }
  },
  "char": {
   "name": "Persona",
   "ps": 100,
   "en": 10,
   "atk": 10,
   "def": 1,
   "vel": 3,
   "pos": "Levantado",
   "arma": "",
   "armadura": "",
   "eib": "",
   "av": ""
  },
  "askName": true,
  "cg": [],
  "intro": "Estas en un edificio abandonado, pero no aparenta estar tan deshabitado. El lugar esta amueblado, limpio y completamente iluminado. Una amiga te a jugado una broma, se a escondido en el edificio y debes encontrarla. Te esperara todo el día hasta que la encuentres.",
  "project_id": "prj_n8bkzft",
  "rules": [
   {
    "id": "gmv1c76vx",
    "name": "Gritar",
    "on": "cmd",
    "pat": "gritar",
    "when": "si: zona:Parqueo | !flag:tiro_grito\n",
    "then": "entonces: activar:tiro_grito | di: Una hoja de papel cae lentamente del techo. |di: Deberías echar un vistazo | mover: Hoja de papel > aqui | mover: Flag TRES > aqui\n",
    "els": "di: Nadie esta escuchando. | di: Tal vez.",
    "once": false,
    "verb": "",
    "o1": "",
    "o2": ""
   },
   {
    "id": "gmv1rs59f",
    "name": "Flor llave",
    "on": "cmd",
    "pat": "presentar",
    "when": "si: sala:Sala de estar AP2-b2 | flag:tienes_rosa | tiene: Flor\nsi: sala:Sala de estar AP2-b2 | !flag:tienes_rosa | tiene: Flor\nsi: !sala:Sala de estar AP2-b2 | !flag:tienes_rosa | tiene: Flor\nsi: !sala:Sala de estar AP2-b2 | !flag:tienes_rosa | !tiene: Flor",
    "then": "entonces: di: Es muy linda.\nentonces: activar: tienes_rosa | mover: Llave pequeña > aqui | di: Ves una llave caer. | mover: Flag UNO > aqui\nentonces: di: Esto no funciona aquí.\nentonces: di: ¿Qué quieres enseñar?",
    "els": "di: ¿Vienes con las manos vacías?",
    "once": false,
    "verb": "",
    "o1": "",
    "o2": ""
   },
   {
    "id": "gmv1u89jc",
    "name": "Cavar",
    "on": "verbo",
    "pat": "",
    "when": "si: sala:Área recreativa | flag:llave_tierra\nsi: sala:Área recreativa | !flag:llave_tierra | tiene:pala\nsi: sala:Área recreativa | !flag:llave_tierra | !tiene:pala",
    "then": "entonces: di: Ya cavaste aquí y no hay nada más en el hoyo.\nentonces: activar: llave_tierra | mover: Llave AP1-6 > aqui | di: Usas la pala para remover la tierra. Dejas al descubierto una llave oxidada. | mover: Flag DOS > aqui\nentonces: di: Necesitas una pala para poder excavar en este suelo.",
    "els": "",
    "once": false,
    "verb": "cavar",
    "o1": "",
    "o2": ""
   },
   {
    "id": "gmv1yf6zx",
    "name": "Besar",
    "on": "verbo",
    "pat": "",
    "when": "si: es: $1 > Ruby | pnj: $1 > aqui\nsi: !es: $1 > Ruby | pnj: $1 > aqui\nsi: !aqui: $1 | pnj: * > aqui",
    "then": "entonces: di: Le besas la mejilla, pero ella te roba los labios. | fin: Gracias por Jugar ENCUÉNTRAME. \nentonces: di: Te acercas a $n1 y le das un beso.\nentonces: di: ¿Besar a quién?",
    "els": "di: Te besas a ti mismo. Que NARCISISTA.",
    "once": false,
    "verb": "vmv1z3tek",
    "o1": "",
    "o2": ""
   },
   {
    "id": "gmv2eqtyh",
    "name": "Observar",
    "on": "cmd",
    "pat": "Observar | Mirar atentamente | Observar * | Mirar atentamente *",
    "when": "si: !aqui: $1\nsi: aqui: $1",
    "then": "  entonces: activar: observando | mirar: sala | desactivar: observando\n  entonces: activar: observando | mirar: $1 | desactivar: observando",
    "els": "",
    "once": false,
    "verb": "",
    "o1": "",
    "o2": ""
   },
   {
    "id": "gmv2kw2dw",
    "name": "Ruby aparece",
    "on": "enter",
    "pat": "",
    "when": "flag: tienes_rosa | flag: llave_tierra | flag: tiro_grito | flag: el_espero | tiene:Collar de plata | tiene: Llave Maestra | tiene:Llave SDE | sala:Aposento 2 AP2-a6 ",
    "then": "pnj: Ruby > aqui | di: Ruby esta aquí.. Te saluda animosamente.",
    "els": "",
    "once": false,
    "verb": "",
    "o1": "",
    "o2": ""
   },
   {
    "id": "gmv2o29ld",
    "name": "Esperar",
    "on": "verbo",
    "pat": "",
    "when": "si: sola: Aposento 1 AP2-b3  | !flag:el_espero",
    "then": "entonces: di: Esperaste mucho tiempo | di: Mira a tu alrededor | mover: Collar de plata > Cocina AP1-a2 | mover: Flag CUATRO > aqui | mover: Nota adhesiva > aqui | activar: el_espero",
    "els": "di: No es necesario hacer eso.",
    "once": false,
    "verb": "esperar",
    "o1": "",
    "o2": ""
   },
   {
    "id": "gmv2t06w3",
    "name": "Ruby no esta aqui",
    "on": "enter",
    "pat": "",
    "when": "  sala: Aposento 2 AP2-a6\n  !pnj: Ruby > aqui",
    "then": "di: Te falta algo.",
    "els": "",
    "once": false,
    "verb": "",
    "o1": "",
    "o2": ""
   },
   {
    "id": "gmv2up19e",
    "name": "Espejo",
    "on": "cmd",
    "pat": "mirar espejo | mirarse en el espejo",
    "when": "si: var: espejo >= 3 | aqui: espejo\nsi: !flag: espejo_visto | aqui: espejo\nsi: flag: espejo_visto | aqui: espejo\n",
    "then": "entonces: fijar: espejo = 0 | activar: espejo_visto | di: Te miras por cuarta vez. Estás impecable, pero Ruby no va a aparecer mágicamente en el reflejo.\nentonces: sumar: espejo = 1 | di: Te miras en el reflejo del cristal marchito. Sigues siendo tú.\nentonces: desactivar: espejo_visto",
    "els": "di: Aquí no hay ningún espejo.",
    "once": false,
    "verb": "",
    "o1": "",
    "o2": ""
   },
